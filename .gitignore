# ── ARIA runtime data ─────────────────────────────────────────────────────────
# Persistent memory — contains personal data (name, notes, etc.)
aria_memory.json
aria_memory.json.tmp

# SQLite conversation history — large, personal, regenerates automatically
conversations.db
conversations.db-shm
conversations.db-wal

# Kokoro TTS model files (~85 MB) — downloaded automatically on first run
kokoro_models/

# Screenshot temp files
aria_screenshots/

# Music temp files
aria_music/

# Calendar export — contains personal events, regenerates automatically
aria_calendar.ics

# Temporary files for uploads — contains personal data, regenerates automatically
aria_uploads/

# User preferences — contains personal data, regenerates automatically
aria_prefs.json

# Other
data/

